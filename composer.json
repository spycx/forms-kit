{
    "name": "spycx/forms-kit",
    "description": "Framework-free web forms: honeypot, signed token, per-IP rate limit and email delivery via symfony/mailer.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["form", "contact", "honeypot", "spam", "mailer"],
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "symfony/mailer": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Spycx\\FormsKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spycx\\FormsKit\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/forms-kit"],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
