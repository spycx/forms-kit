#!/usr/bin/env php
<?php
/**
 * spycx/forms-kit tools.
 *
 *   vendor/bin/forms-kit publish [directory]
 *       Copies forms-kit.js to the site's public directory (the current one by default).
 *       vendor/ isn't publicly served, so the JS has to be copied. Run it from the site's
 *       composer.json "post-install-cmd" and "post-update-cmd".
 */

declare(strict_types=1);

$command = $argv[1] ?? '';

if ($command !== 'publish') {
    fwrite(STDERR, "Usage: forms-kit publish [directory]\n");
    exit(1);
}

$source = dirname(__DIR__) . '/resources/js/forms-kit.js';
$target = rtrim($argv[2] ?? getcwd(), '/') . '/forms-kit.js';

if (!is_dir(dirname($target))) {
    fwrite(STDERR, "forms-kit: directory does not exist: " . dirname($target) . "\n");
    exit(1);
}
if (!copy($source, $target)) {
    fwrite(STDERR, "forms-kit: could not copy to $target\n");
    exit(1);
}

echo "forms-kit: published $target\n";
